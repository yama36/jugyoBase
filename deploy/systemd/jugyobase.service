[Unit]
Description=jugyoBase (Docker Compose: Postgres + MinIO + Next.js)
Documentation=https://github.com/yama36/jugyoBase
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=jugyobase
Group=jugyobase
WorkingDirectory=/opt/jugyobase
# compose の ${POSTGRES_PASSWORD} 等の補間に使う（コンテナ env は各サービスの env_file で読む）
EnvironmentFile=/opt/jugyobase/.env.production
ExecStart=/usr/bin/docker compose -f /opt/jugyobase/deploy/docker-compose.prod.yml --env-file /opt/jugyobase/.env.production up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f /opt/jugyobase/deploy/docker-compose.prod.yml --env-file /opt/jugyobase/.env.production stop
TimeoutStopSec=120

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
