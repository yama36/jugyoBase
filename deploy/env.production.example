# =============================================================
# jugyoBase 本番用環境変数テンプレート
#   - サーバ上にコピーして `.env.production` として配置する
#   - 値は実運用に合わせて差し替える
#   - 機密値（AUTH_SECRET, POSTGRES_PASSWORD, MINIO_ROOT_PASSWORD,
#     S3_SECRET_ACCESS_KEY, AUTH_GOOGLE_SECRET）はリポジトリに
#     コミットしないこと
# =============================================================

# ---- PostgreSQL（docker compose の値と一致させる） ------------
POSTGRES_USER=jugyobase
POSTGRES_PASSWORD=__CHANGE_ME__       # `openssl rand -base64 24` 推奨
POSTGRES_DB=jugyobase
# ホストで npx tsx scripts 等を叩くとき用（127.0.0.1）
DATABASE_URL=postgresql://jugyobase:__CHANGE_ME__@127.0.0.1:5432/jugyobase
# Docker の app 用（ホスト名 postgres）。パスワードに / + @ 等がある場合は URL エンコード必須。
# 例: node -e 'console.log(encodeURIComponent(process.argv[1]))' 'your+raw/password'
DATABASE_URL_DOCKER=postgresql://jugyobase:__CHANGE_ME__@postgres:5432/jugyobase

# ---- Auth.js / Google OAuth -----------------------------------
# 32 byte base64。`openssl rand -base64 32`
AUTH_SECRET=__CHANGE_ME__
# 必ず「オリジン」のみ。/jugyobase を含めない（README 参照）
AUTH_URL=https://identfill.com
# 開発と同じ Google OAuth クライアントを使う場合も値はそのままでよい
# Google Cloud Console 側で本番用リダイレクト URI を追加すること:
#   https://identfill.com/jugyobase/api/auth/callback/google
AUTH_GOOGLE_ID=__YOUR_GOOGLE_CLIENT_ID__
AUTH_GOOGLE_SECRET=__YOUR_GOOGLE_CLIENT_SECRET__

# ---- MinIO（同一サーバに同居・docker compose の値と一致させる） ----
MINIO_ROOT_USER=jugyobase
MINIO_ROOT_PASSWORD=__CHANGE_ME__     # 20 文字以上推奨
# 署名検証で使われるホスト。Nginx 側の公開 URL と必ず一致させる
MINIO_SERVER_URL=https://s3.identfill.com
# 管理コンソールの公開リダイレクト URL（コンソールを別サブドメインで公開する場合）
# 公開しない運用なら `https://s3.identfill.com` のままでも問題ない
MINIO_BROWSER_REDIRECT_URL=https://s3.identfill.com
# ブラウザ直 PUT/GET の CORS。Nginx s3.identfill.conf で add_header しないこと
MINIO_API_CORS_ALLOW_ORIGIN=https://identfill.com

# ---- アプリから MinIO を見るときの S3 設定 --------------------
# バケットは初回起動後に MinIO コンソールで作成する
S3_BUCKET=jugyobase
S3_REGION=us-east-1
# MinIO のルートユーザを使うのではなく、サービスアカウント（アクセスキー）を
# 発行して限定権限で渡すのが望ましい
S3_ACCESS_KEY_ID=__CHANGE_ME__
S3_SECRET_ACCESS_KEY=__CHANGE_ME__
# 署名 URL の発行先。MINIO_SERVER_URL と必ず同じ値
S3_ENDPOINT=https://s3.identfill.com

# ---- Next.js ランタイム ---------------------------------------
NODE_ENV=production
# ブラウザ直 PUT の presigned URL から CRC32 クエリを付けない（MinIO 403 防止）
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED
# Nginx の裏でだけ受ける
HOSTNAME=127.0.0.1
PORT=3001

# ---- お問い合わせフォーム（yamalog API 中継） ------------------
# ブラウザは /jugyobase/api/contact-form/* を叩く。上流のみサーバーから到達
# CONTACT_FORM_UPSTREAM_BASE=https://yamalog.net/api/contactForm
# 本番で NEXT_PUBLIC_CONTACT_FORM_* を yamalog 直 URL にすると CORS で失敗するため未設定推奨

# ---- マルウェア検査 Webhook（任意） ---------------------------
# 設定すると新規添付はスキャン完了までダウンロード不可。`openssl rand -hex 32`
# MALWARE_SCAN_WEBHOOK_SECRET=
