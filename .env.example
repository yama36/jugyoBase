# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/jugyoBase"

# Auth.js / Google（https://console.cloud.google.com/apis/credentials）
AUTH_SECRET="openssl rand -base64 32 で生成"
# オリジンのみでよい（Auth の実パスは src/auth.ts の basePath で /jugyobase/api/auth に固定）
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 互換: 旧名
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# S3 互換（MinIO なら S3_ENDPOINT を指定）
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="http://127.0.0.1:9000"

# マルウェア検査（任意・S3 直 PUT 後の Webhook）
# 設定すると新規添付は「検査待ち」になり、POST /jugyobase/api/internal/malware-scan で clean になるまでダウンロード不可。
# MALWARE_SCAN_WEBHOOK_SECRET="openssl rand -hex 32 で生成"
